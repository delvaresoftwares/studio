rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow anyone to create a contact document through the form
    match /contacts/{contactId} {
      allow create: if true;
      // TEMPORARY: Allow read/delete for testing. In production, use Firebase Admin SDK.
      allow read, delete, update: if true;
    }

    // Allow anyone to create an estimation document
    match /estimations/{estimationId} {
      allow create: if true;
      // TEMPORARY: Allow read/delete for testing. In production, use Firebase Admin SDK.
      allow read, delete, update: if true;
    }

    // Anonymous page-visit tracking (read by the admin dashboard).
    match /visits/{visitId} {
      allow create, read: if true;
      allow update, delete: if false;
    }

    // Button-click tracking (read by the admin dashboard).
    match /clicks/{clickId} {
      allow create, read: if true;
      allow update, delete: if false;
    }

    // Traffic-source tracking links (redirects like delvare.in/linked-in).
    match /traffic_sources/{sourceId} {
      allow create, read: if true;
      allow update, delete: if false;
    }
  }
}